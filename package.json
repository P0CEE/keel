{
  "name": "keel",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@ai-sdk/openai": "^3.0.50",
      "@hono/node-server": "^1.19.11",
      "@hono/trpc-server": "^0.4.0",
      "@hono/zod-openapi": "^1.1.5",
      "@radix-ui/react-avatar": "^1.1.10",
      "@radix-ui/react-checkbox": "^1.3.3",
      "@radix-ui/react-collapsible": "^1.1.12",
      "@radix-ui/react-dialog": "^1.1.15",
      "@radix-ui/react-dropdown-menu": "^2.1.16",
      "@radix-ui/react-hover-card": "^1.1.15",
      "@radix-ui/react-label": "^2.1.7",
      "@radix-ui/react-popover": "^1.1.15",
      "@radix-ui/react-scroll-area": "^1.2.10",
      "@radix-ui/react-select": "^2.2.6",
      "@radix-ui/react-separator": "^1.1.7",
      "@radix-ui/react-slot": "^1.2.3",
      "@radix-ui/react-switch": "^1.2.6",
      "@radix-ui/react-tabs": "^1.1.13",
      "@radix-ui/react-toggle": "^1.1.10",
      "@radix-ui/react-toggle-group": "^1.1.11",
      "@radix-ui/react-tooltip": "^1.2.8",
      "@scalar/hono-api-reference": "^0.9.13",
      "@sentry/nextjs": "^10",
      "@tailwindcss/postcss": "4.1.13",
      "@tailwindcss/vite": "4.1.13",
      "@tanstack/react-query": "^5.90.2",
      "@trpc/client": "^11.16.0",
      "@trpc/server": "^11.16.0",
      "@trpc/tanstack-react-query": "^11.16.0",
      "@types/bun": "^1.3.12",
      "@types/node": "^22",
      "@types/pg": "^8.15.0",
      "@types/react": "19.2.7",
      "@types/react-dom": "19.2.3",
      "@vitejs/plugin-react": "5.0.3",
      "ai": "^6.0.150",
      "babel-plugin-react-compiler": "^1.0.0",
      "better-auth": "^1.6.11",
      "bullmq": "^5.71.1",
      "class-variance-authority": "^0.7.1",
      "clsx": "^2.1.1",
      "cmdk": "^1.1.1",
      "drizzle-kit": "^0.31.5",
      "drizzle-orm": "^0.45.0",
      "hono": "4.12.22",
      "husky": "9.1.7",
      "ioredis": "^5.8.1",
      "lint-staged": "16.2.7",
      "lucide-react": "^0.545.0",
      "next": "16.2.6",
      "next-international": "1.3.1",
      "next-themes": "^0.4.6",
      "oxfmt": "0.27.0",
      "oxlint": "1.42.0",
      "oxlint-tsgolint": "0.11.3",
      "pg": "^8.16.0",
      "react": "19.2.4",
      "react-dom": "19.2.4",
      "superjson": "^2.2.6",
      "tailwind-merge": "^3.3.1",
      "tailwindcss": "4.1.13",
      "turbo": "2.9.14",
      "tw-animate-css": "^1.4.0",
      "typescript": "5.9.2",
      "vite": "^7.1.12",
      "zod": "^4.3.6"
    }
  },
  "type": "module",
  "scripts": {
    "setup": "bun install && echo \"Setup complete. Next: copy each .env.example to .env, run 'docker compose up -d', then 'bun run db:migrate'.\"",
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:website": "turbo dev --filter=@keel/website",
    "dev:app": "turbo dev --filter=@keel/app",
    "dev:api": "turbo dev --filter=@keel/api",
    "dev:worker": "turbo dev --filter=@keel/worker",
    "db:generate": "bun --filter @keel/db db:generate",
    "db:migrate": "bun --filter @keel/db db:migrate",
    "db:push": "bun --filter @keel/db db:push",
    "clean": "bun scripts/clean.ts",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "lint": "oxlint --type-aware --tsconfig tsconfig.json .",
    "lint:fix": "oxlint --type-aware --tsconfig tsconfig.json --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint-staged": "lint-staged",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": [
      "oxfmt --write",
      "oxlint --type-aware --tsconfig tsconfig.json --fix"
    ],
    "**/*.{json,md,css}": [
      "oxfmt --write"
    ]
  },
  "packageManager": "bun@1.3.14",
  "trustedDependencies": [
    "@tailwindcss/oxide",
    "msgpackr-extract",
    "core-js",
    "esbuild",
    "sharp"
  ]
}
