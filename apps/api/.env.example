NODE_ENV=development

# Hono server port.
PORT=3001

# Allowed browser origin (the @keel/app product).
CORS_ORIGIN=http://localhost:3173

# Postgres — Drizzle + Better Auth store. Matches docker-compose.
DATABASE_URL=postgres://keel:keel@localhost:5432/keel

# Redis — BullMQ queue and rate limiter.
REDIS_URL=redis://localhost:6379

# Better Auth signing secret (min 32 chars). Generate: openssl rand -hex 32
BETTER_AUTH_SECRET=

# Public origin Better Auth issues callbacks/cookies for (this API).
BETTER_AUTH_URL=http://localhost:3001

# Google OAuth (the only sign-in method). Redirect URI to allow in the
# Google console: http://localhost:3001/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OpenAI API key — only required to call the AI (vision) endpoints.
OPENAI_API_KEY=

# Bank aggregator for new connections: "fake" (scenario bank, no network)
# or "enable_banking" (needs the two variables below).
BANKING_PROVIDER=fake
ENABLEBANKING_APPLICATION_ID=
# The application's private key: the PEM, or its base64.
ENABLE_BANKING_KEY_CONTENT=
# Where the bank sends the member back. Allow it in the Enable Banking
# application's redirect URLs.
ENABLEBANKING_REDIRECT_URL=http://localhost:3001/v1/bank/callback

# HMAC secret for inbound webhooks. Generate with: openssl rand -hex 32
WEBHOOK_SECRET=
