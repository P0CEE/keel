NODE_ENV=development

# Hono server port.
PORT=3001

# Allowed browser origin (the @keel/app product).
CORS_ORIGIN=http://localhost:3173

# Postgres — Drizzle + Better Auth store. Matches docker-compose.
DATABASE_URL=postgres://keel:keel@localhost:5432/keel

# Redis — BullMQ queue and rate limiter.
REDIS_URL=redis://localhost:6379

# Better Auth signing secret (min 32 chars). Generate: openssl rand -hex 32
BETTER_AUTH_SECRET=

# Public origin Better Auth issues callbacks/cookies for (this API).
BETTER_AUTH_URL=http://localhost:3001

# OpenAI API key — only required to call the AI (vision) endpoints.
OPENAI_API_KEY=

# HMAC secret for inbound webhooks. Generate with: openssl rand -hex 32
WEBHOOK_SECRET=
