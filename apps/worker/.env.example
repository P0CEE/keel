NODE_ENV=development

# Worker HTTP port (health checks).
PORT=8080

# Redis — BullMQ queues (shared with the API producer).
REDIS_URL=redis://localhost:6379

# Postgres. In production, connect as a login role that is keel_app or a
# member of it (ADR 0013); locally the docker-compose owner is fine, since
# withScope drops to keel_app for every scoped transaction.
DATABASE_URL=postgres://keel:keel@localhost:5432/keel

# Concurrent jobs per queue.
WORKER_CONCURRENCY_BANK_SYNC=2
WORKER_CONCURRENCY_BANK_PIPELINE=4
WORKER_CONCURRENCY_DEFAULT=5

# Bank aggregator, as in apps/api/.env.example: the worker refreshes the
# bank list and revokes purged connections through it.
BANKING_PROVIDER=fake
ENABLEBANKING_APPLICATION_ID=
ENABLE_BANKING_KEY_CONTENT=
ENABLEBANKING_REDIRECT_URL=http://localhost:3001/v1/bank/callback

# The categorization model (bank.categorize) on the Vercel AI Gateway.
# Empty: what the ladder cannot decide goes to the review queue.
AI_GATEWAY_API_KEY=
# Zero data retention needs the Gateway's Pro plan; a Hobby key must set
# this to false. Keep it true in production.
AI_ZERO_DATA_RETENTION=true
# Override a model by role (packages/ai/src/models.ts); replay the eval
# (`bun run eval:categorization` in packages/banking) before any change.
# AI_MODEL_CATEGORIZE=openai/gpt-6-luna
# AI_MODEL_CATEGORIZE_FALLBACK=google/gemini-3.1-flash-lite
