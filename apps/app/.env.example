# Public URL this app is served from.
NEXT_PUBLIC_APP_URL=http://localhost:3173

# @keel/api base URL (the app calls <URL>/trpc and <URL>/api/auth/*).
NEXT_PUBLIC_API_URL=http://localhost:3001

# Sentry — only enabled when NODE_ENV=production.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Public site, for the terms and privacy links of the sign-in page.
NEXT_PUBLIC_WEBSITE_URL=http://localhost:3000
